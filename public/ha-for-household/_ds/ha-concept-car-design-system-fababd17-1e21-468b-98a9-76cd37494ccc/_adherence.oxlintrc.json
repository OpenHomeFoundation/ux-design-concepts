{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/entities/**",
              "components/forms/**",
              "components/lists/**",
              "components/navigation/**",
              "design-tokens.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Inter Tight|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Inter, Inter Tight, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:action|actor|time|icon|key|ref|className|style|children)$/]",
        "message": "<ActivityItem> doesn't accept that prop. Declared props: action, actor, time, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:breakpoint|rail|panel|bar|children|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: breakpoint, rail, panel, bar, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:mobile|tablet|desktop)$/]",
        "message": "<AppShell> breakpoint must be one of 'mobile' | 'tablet' | 'desktop'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|summary|key|ref|className|style|children)$/]",
        "message": "<AreaCard> doesn't accept that prop. Declared props: icon, name, summary."
      },
      {
        "selector": "JSXOpeningElement[name.name='AutomationItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|creator|enabled|canEdit|onToggle|onEdit|key|ref|className|style|children)$/]",
        "message": "<AutomationItem> doesn't accept that prop. Declared props: name, creator, enabled, canEdit, onToggle, onEdit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|max|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: count, max, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookmarkItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|href|onClick|key|ref|className|style|children)$/]",
        "message": "<BookmarkItem> doesn't accept that prop. Declared props: id, label, icon, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|href|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger|icon)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger' | 'icon'."
      },
